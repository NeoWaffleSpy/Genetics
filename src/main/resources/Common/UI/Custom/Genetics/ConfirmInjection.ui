$C = "../Common.ui";

$C.@PageOverlay {}

// Warning shown before injecting a genome that is over the player's Genome Capacity.
$C.@DecoratedContainer #Panel {
  Anchor: (Width: 560, Height: 300);

  #Title {
    Group {
      $C.@Title {
        @Text = "Over capacity";
      }
    }
  }

  #Content {
    Group {
      LayoutMode: Top;
      FlexWeight: 1;
      Padding: (Full: 10);

      Label #Numbers {
        Padding: (Bottom: 12);
        Style: (FontSize: 18, RenderBold: true, TextColor: #e06666);
      }

      Label #Details {
        FlexWeight: 1;
        Style: (FontSize: 16, TextColor: #96a9be, Wrap: true);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 48);

        $C.@CancelTextButton #CancelButton {
          @Text = "Cancel";
        }

        Group {
          FlexWeight: 1;
        }

        $C.@TextButton #InjectButton {
          @Text = "Inject anyway";
        }
      }
    }
  }
}
