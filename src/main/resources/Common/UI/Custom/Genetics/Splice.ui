$C = "../Common.ui";

$C.@PageOverlay {}

// Splicing two genetic materials (design doc §7): the one in the station is A, the player picks B from their
// inventory. Every gene shows its odds of coming from A, from B, or being lost.
$C.@DecoratedContainer #Panel {
  @CloseButton = true;
  Anchor: (Width: 900, Height: 620);

  #Title {
    Group {
      $C.@Title {
        @Text = "Splice Genetic Material";
      }
    }
  }

  #Content {
    Group {
      LayoutMode: Left;
      FlexWeight: 1;
      Padding: (Full: 10);

      // Left: A, and the materials B can be picked from.
      Group {
        LayoutMode: Top;
        Anchor: (Width: 300);
        Padding: (Right: 14);

        Label {
          Text: "A (in the station)";
          Style: (RenderBold: true, TextColor: #E8A93B);
        }

        Label #NameA {
          Padding: (Top: 2, Bottom: 12);
          Style: (FontSize: 16, RenderBold: true, Wrap: true);
        }

        Label {
          Text: "B (from your inventory)";
          Padding: (Bottom: 4);
          Style: (RenderBold: true, TextColor: #E8A93B);
        }

        Label #NoCandidates {
          Text: "You carry no other genetic material. Process another sample first.";
          Visible: false;
          Style: (TextColor: #878e9c, Wrap: true);
        }

        Group #Candidates {
          LayoutMode: TopScrolling;
          FlexWeight: 1;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }

      // Right: the odds and the cost.
      Group {
        LayoutMode: Top;
        FlexWeight: 1;
        Padding: (Full: 10);
        Background: #000000(0.2);

        Label #PickHint {
          Text: "Pick a second genetic material to see the odds.";
          Style: (FontSize: 16, TextColor: #878e9c, Wrap: true);
        }

        Group #Result {
          LayoutMode: Top;
          FlexWeight: 1;
          Visible: false;

          Group {
            LayoutMode: Left;
            Anchor: (Height: 26);

            Label {
              Text: "Gene";
              FlexWeight: 1;
              Style: (RenderBold: true, TextColor: #E8A93B);
            }

            Label {
              Text: "From A";
              Anchor: (Width: 110);
              Style: (RenderBold: true, TextColor: #E8A93B, HorizontalAlignment: End);
            }

            Label {
              Text: "From B";
              Anchor: (Width: 110);
              Style: (RenderBold: true, TextColor: #E8A93B, HorizontalAlignment: End);
            }

            Label {
              Text: "Lost";
              Anchor: (Width: 60);
              Style: (RenderBold: true, TextColor: #E8A93B, HorizontalAlignment: End);
            }
          }

          Group #OddsList {
            LayoutMode: TopScrolling;
            FlexWeight: 1;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
          }

          Group {
            Anchor: (Height: 1);
            Background: #2b3542;
          }

          Label #Mutation {
            Padding: (Top: 8);
            Style: (RenderBold: true, TextColor: #c58cf0);
          }

          Label #Tier {
            Padding: (Top: 4);
            Style: (RenderBold: true, TextColor: #96a9be);
          }

          Label #Warning {
            Visible: false;
            Padding: (Top: 4);
            Style: (RenderBold: true, TextColor: #e06666, Wrap: true);
          }

          Group #CostList {
            LayoutMode: Left;
            Anchor: (Height: 40, Top: 6);
          }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 48, Top: 10);

          $C.@CancelTextButton #CancelButton {
            @Text = "Back";
          }

          Group {
            FlexWeight: 1;
          }

          $C.@TextButton #SpliceButton {
            @Text = "Splice";
          }
        }
      }
    }
  }
}
