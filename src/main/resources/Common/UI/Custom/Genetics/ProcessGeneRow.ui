$C = "../Common.ui";

// One gene on the processing screen: a keep tickbox, the gene, a "Make permanent" tickbox for long temporary
// effects, and how much Complexity it adds.
Group {
  LayoutMode: Left;
  Anchor: (Height: 40);
  Padding: (Bottom: 4);

  Group {
    LayoutMode: Middle;
    Anchor: (Width: 40);

    $C.@CheckBox #Toggle {
      Value: true;
    }
  }

  Label #Name {
    FlexWeight: 1;
    Padding: (Left: 10);
    Style: (FontSize: 16, VerticalAlignment: Center);
  }

  Group #PermanentBox {
    LayoutMode: Left;
    Anchor: (Width: 140);
    Visible: false;

    Group {
      LayoutMode: Middle;
      Anchor: (Width: 30);

      $C.@CheckBox #Permanent {
        Value: false;
      }
    }

    Label {
      Text: "Make permanent";
      Padding: (Left: 6);
      Style: (FontSize: 13, TextColor: #c58cf0, VerticalAlignment: Center);
    }
  }

  Label #Cost {
    Anchor: (Width: 150);
    Style: (FontSize: 14, TextColor: #96a9be, HorizontalAlignment: End, VerticalAlignment: Center);
  }
}
