$C = "../Common.ui";

// One gene on the processing screen: a Keep/Drop toggle, the gene, and how much Complexity it adds.
Group {
  LayoutMode: Left;
  Anchor: (Height: 40);
  Padding: (Bottom: 4);

  Group {
    LayoutMode: Left;
    Anchor: (Width: 110);

    $C.@SmallSecondaryTextButton #Toggle {
      @Text = "Keep";
    }
  }

  Label #Name {
    FlexWeight: 1;
    Padding: (Left: 10);
    Style: (FontSize: 16, VerticalAlignment: Center);
  }

  Label #Cost {
    Anchor: (Width: 150);
    Style: (FontSize: 14, TextColor: #96a9be, HorizontalAlignment: End, VerticalAlignment: Center);
  }
}
