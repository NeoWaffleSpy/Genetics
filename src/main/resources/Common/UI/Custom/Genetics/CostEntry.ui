// One material of a cost: its icon and "have / need", red when the player doesn't carry enough.
Group {
  LayoutMode: Left;
  Anchor: (Width: 130, Height: 40);

  ItemSlot #Icon {
    Anchor: (Width: 36, Height: 36);
    ShowQualityBackground: true;
  }

  Label #Amount {
    Padding: (Left: 6);
    Style: (FontSize: 15, RenderBold: true, VerticalAlignment: Center);
  }
}
