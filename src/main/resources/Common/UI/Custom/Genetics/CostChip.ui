// One material of a cost: its icon, its name and "have / need" (red when the player doesn't carry enough).
// Fixed width so four chips and the main button always fit; long names are cut with an ellipsis.
Group {
  LayoutMode: Left;
  Anchor: (Width: 148, Height: 44);
  Padding: (Right: 8);

  Group {
    LayoutMode: Left;
    FlexWeight: 1;
    Padding: (Left: 4, Right: 6);
    Background: #ffffff(0.035);

    Group {
      LayoutMode: Top;
      Anchor: (Width: 36);
      Padding: (Top: 4);

      ItemSlot #Icon {
        Anchor: (Width: 36, Height: 36);
        ShowQualityBackground: true;
      }
    }

    Group {
      LayoutMode: Top;
      FlexWeight: 1;
      Padding: (Left: 6, Top: 5);

      Label #Item {
        Style: (FontSize: 12, TextColor: #a9b9c7);
      }

      Label #Amount {
        Style: (FontSize: 15, RenderBold: true, TextColor: #8fd17a);
      }
    }
  }
}
