$C = "../Common.ui";

// One genetic material the player can pick as B.
Group {
  LayoutMode: Left;
  Anchor: (Height: 40);
  Padding: (Bottom: 4);

  Group {
    LayoutMode: Left;
    Anchor: (Width: 100);

    $C.@SmallSecondaryTextButton #Pick {
      @Text = "Pick";
    }
  }

  Label #Name {
    FlexWeight: 1;
    Padding: (Left: 8);
    Style: (FontSize: 14, VerticalAlignment: Center, Wrap: true);
  }
}
