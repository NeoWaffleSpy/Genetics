$C = "../Common.ui";

$C.@PageOverlay {}

// Processing a raw sample (design doc §7): choose which genes to keep, see the resulting Complexity, its tier and
// what it costs, then turn the sample into genetic material.
$C.@DecoratedContainer #Panel {
  @CloseButton = true;
  Anchor: (Width: 760, Height: 600);

  #Title {
    Group {
      $C.@Title {
        @Text = "Process Sample";
      }
    }
  }

  #Content {
    Group {
      LayoutMode: Top;
      FlexWeight: 1;
      Padding: (Full: 10);

      Label #SampleName {
        Style: (FontSize: 22, RenderBold: true);
      }

      Label {
        Text: "Choose the genes to keep. Keeping fewer or weaker genes lowers the Complexity, so processing costs less and the result fits your capacity more easily.";
        Padding: (Top: 4, Bottom: 10);
        Style: (FontSize: 14, TextColor: #96a9be, Wrap: true);
      }

      Group #GeneList {
        LayoutMode: TopScrolling;
        FlexWeight: 1;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }

      Group {
        Anchor: (Height: 1);
        Background: #2b3542;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 30);
        Padding: (Top: 8);

        Label #Complexity {
          Padding: (Right: 20);
          Style: (RenderBold: true, TextColor: #E8A93B);
        }

        Label #Tier {
          Padding: (Right: 20);
          Style: (RenderBold: true, TextColor: #96a9be);
        }

        Label #Capacity {
          Style: (RenderBold: true, TextColor: #96a9be);
        }
      }

      Label #Warning {
        Visible: false;
        Padding: (Top: 4);
        Style: (RenderBold: true, TextColor: #e06666, Wrap: true);
      }

      Label {
        Text: "Cost";
        Padding: (Top: 8, Bottom: 4);
        Style: (RenderBold: true, TextColor: #E8A93B);
      }

      Group #CostList {
        LayoutMode: Left;
        Anchor: (Height: 40);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 48, Top: 10);

        $C.@CancelTextButton #CancelButton {
          @Text = "Back";
        }

        Group {
          FlexWeight: 1;
        }

        $C.@TextButton #ProcessButton {
          @Text = "Process";
        }
      }
    }
  }
}
