// One stat gene: "Max Health  +6.5%". Drawbacks use the red #Drawback label instead of #Value.
Group {
  LayoutMode: Left;
  Anchor: (Height: 24);

  Label #Name {
    FlexWeight: 1;
    Style: (TextColor: #96a9be);
  }

  Label #Value {
    Style: (RenderBold: true, TextColor: #8fd17a);
  }

  Label #Drawback {
    Visible: false;
    Style: (RenderBold: true, TextColor: #e06666);
  }
}
