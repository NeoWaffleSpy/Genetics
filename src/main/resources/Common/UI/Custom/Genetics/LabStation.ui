$C = "../Common.ui";

@SlotStyle = (
  SlotSize: 64,
  SlotIconSize: 56,
  SlotSpacing: 4,
  SlotBackground: "../Common/BlockSelectorSlotBackground.png"
);

@Separator = Group {
  Anchor: (Top: 0, Height: 1);
  Background: (Color: #25262c);
};

$C.@PageOverlay {}

// Middle: the station, its sample slot and the analysis of the sample.
$C.@DecoratedContainer #Panel {
  @CloseButton = true;
  Anchor: (Width: 820, Height: 470, Bottom: 480);

  #Title {
    Group {
      $C.@Title {
        @Text = "Lab Station";
      }
    }
  }

  #Content {
    Group {
      LayoutMode: Left;
      FlexWeight: 1;

      // Left: the slot and the sampled mob's portrait.
      Group {
        LayoutMode: Top;
        Anchor: (Width: 150);

        // Fixed heights: LabStationPage places the tooltip from these sizes.
        Label {
          Text: "Sample";
          Anchor: (Height: 32);
          Padding: (Bottom: 8);
          Style: (RenderBold: true, TextColor: #E8A93B);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 64);

          ItemGrid #SampleSlot {
            Anchor: (Width: 64, Height: 64);
            SlotsPerRow: 1;
            AreItemsDraggable: true;
            InfoDisplay: None;
            Style: @SlotStyle;
          }
        }

        AssetImage #MobIcon {
          Anchor: (Width: 96, Height: 96, Top: 8);
          Visible: false;
        }

        Group {
          FlexWeight: 1;
        }

        // The station's tier and its upgrade (like a vanilla bench upgrade).
        Label #StationTier {
          Anchor: (Height: 24);
          Style: (RenderBold: true, TextColor: #E8A93B);
        }

        Group #UpgradePanel {
          LayoutMode: Top;
          Visible: false;

          Group #UpgradeCost {
            LayoutMode: Top;
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 34, Top: 4);

            $C.@SmallSecondaryTextButton #UpgradeButton {
              @Text = "Upgrade";
            }
          }
        }
      }

      // Right: the analysis.
      Group {
        LayoutMode: Top;
        FlexWeight: 1;
        Padding: (Full: 14);
        Background: #000000(0.2);

        Label #EmptyLabel {
          Text: "Empty";
          Style: (FontSize: 22, RenderBold: true, TextColor: #878e9c);
        }

        Group #Details {
          LayoutMode: Top;
          FlexWeight: 1;
          Visible: false;

          Label #MobName {
            Style: (FontSize: 24, RenderBold: true);
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 26);
            Padding: (Bottom: 10);

            Label #Kind {
              Padding: (Right: 16);
              Style: (RenderBold: true, TextColor: #96a9be);
            }

            Label #Complexity {
              Padding: (Right: 16);
              Style: (RenderBold: true, TextColor: #E8A93B);
            }

            Label #Capacity {
              Style: (RenderBold: true, TextColor: #96a9be);
            }
          }

          Label #CapacityWarning {
            Visible: false;
            Padding: (Bottom: 8);
            Style: (RenderBold: true, TextColor: #e06666, Wrap: true);
          }

          Label #CapacityOk {
            Visible: false;
            Padding: (Bottom: 8);
            Style: (RenderBold: true, TextColor: #8fd17a);
          }

          // Process (raw samples) or Splice (genetic material), from Lab Station T2.
          Group #Actions {
            LayoutMode: Left;
            Anchor: (Height: 40);
            Padding: (Bottom: 6);

            $C.@SmallSecondaryTextButton #ProcessButton {
              @Text = "Process...";
              Visible: false;
            }

            $C.@SmallSecondaryTextButton #SpliceButton {
              @Text = "Splice...";
              Visible: false;
            }

            Label #ActionHint {
              FlexWeight: 1;
              Padding: (Left: 10);
              Style: (FontSize: 13, TextColor: #878e9c, VerticalAlignment: Center, Wrap: true);
            }
          }

          // Shown instead of the genes while the sample is unidentified.
          Group #IdentifyPanel {
            LayoutMode: Top;
            FlexWeight: 1;
            Visible: false;

            Label {
              Text: "This sample hasn't been identified yet. Identify it to reveal its genes and Complexity, or inject it blind.";
              Padding: (Bottom: 14);
              Style: (FontSize: 16, TextColor: #96a9be, Wrap: true);
            }

            Label #ReagentCount {
              Padding: (Bottom: 10);
              Style: (RenderBold: true, TextColor: #E8A93B);
            }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 48);

              $C.@TextButton #IdentifyButton {
                @Text = "Identify (1 reagent)";
              }
            }
          }

          Group #Genes {
            LayoutMode: Left;
            FlexWeight: 1;

            Group {
              LayoutMode: Top;
              Anchor: (Width: 230);
              Padding: (Right: 20);

              Label {
                Text: "Stat genes";
                Padding: (Bottom: 6);
                Style: (RenderBold: true, TextColor: #E8A93B);
              }

              Label #NoStats {
                Text: "None";
                Style: (TextColor: #878e9c);
              }

              Group #StatList {
                LayoutMode: TopScrolling;
                FlexWeight: 1;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;
              }
            }

            Group {
              LayoutMode: Top;
              FlexWeight: 1;

              Label {
                Text: "Effect genes";
                Padding: (Bottom: 6);
                Style: (RenderBold: true, TextColor: #E8A93B);
              }

              Label #NoEffects {
                Text: "None";
                Style: (TextColor: #878e9c);
              }

              Group #EffectList {
                LayoutMode: TopScrolling;
                FlexWeight: 1;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;
              }
            }
          }
        }
      }
    }
  }
}

// Bottom: the player's inventory.
$C.@DecoratedContainer #InventoryPanel {
  // Content width = the grids' width (608 + 2 x 17 padding), so the slots' positions are known exactly.
  Anchor: (Width: 642, Height: 420, Bottom: 30);

  #Title {
    Group {
      $C.@Title {
        @Text = "Inventory";
      }
    }
  }

  #Content {
    ItemGrid #Storage {
      Anchor: (Width: 608, Height: 268);
      SlotsPerRow: 9;
      AreItemsDraggable: true;
      InfoDisplay: None;
      Style: @SlotStyle;
    }

    ItemGrid #Hotbar {
      Anchor: (Width: 608, Height: 64, Top: 12);
      SlotsPerRow: 9;
      AreItemsDraggable: true;
      InfoDisplay: None;
      Style: @SlotStyle;
    }
  }
}

// Our own item tooltip, a copy of the game's (Interface/InGame/Tooltips/ItemTooltip.ui). The grids' built-in
// tooltip is turned off (InfoDisplay: None) because it stayed on screen when the page closed under it; this one
// belongs to the page, so it closes with it.
// The layer covers both panels (bottom of the inventory to top of the station). LabStationPage places the tooltip
// in it: #TooltipGap (under the tooltip) is the distance from the layer's bottom, #TooltipIndent from its left.
Group #TooltipLayer {
  Anchor: (Width: 820, Height: 920, Bottom: 30);
  LayoutMode: Bottom;
  Visible: false;

  Group {
    LayoutMode: Left;

    Group #TooltipIndent {
      Anchor: (Width: 0);
    }

    Group #ItemTooltip {
      Anchor: (Width: 320);
      Background: (TexturePath: "Tooltips/ItemTooltipDefault.png", Border: 24);

      Group #TooltipArrow {
        Anchor: (Width: 33, Height: 24, Bottom: -8);
        Background: (TexturePath: "Tooltips/ItemTooltipDefaultArrow.png");
      }

      Group {
        Padding: (Full: 24, Top: 21);
        LayoutMode: Top;

        Group {
          LayoutMode: Left;

          Label #TooltipName {
            FlexWeight: 2;
            Style: (RenderBold: true, FontSize: 18, Wrap: true);
          }

          Label #TooltipQuality {
            Padding: (Left: 5, Top: 3);
            Style: (HorizontalAlignment: End, FontSize: 14);
          }
        }

        Group #TooltipDescription {
          Padding: (Top: 5);

          @Separator {}

          Label #TooltipDescriptionText {
            Anchor: (Top: 6);
            Style: (TextColor: #696969, FontSize: 14, Wrap: true);
          }
        }

        Group #TooltipFooter {
          Padding: (Top: 5);

          @Separator {}

          Label #TooltipDurability {
            Anchor: (Top: 6);
            Style: (HorizontalAlignment: End, TextColor: #bca57a, FontSize: 14);
          }
        }
      }
    }
  }

  // Below the tooltip: Bottom layout keeps the children's order and pushes the stack down, so this spacer
  // lifts the tooltip off the layer's bottom.
  Group #TooltipGap {
    Anchor: (Height: 0);
  }
}
