// One card per effect or mutation gene.
Group {
  LayoutMode: Top;
  Padding: (Bottom: 6);

  Group {
    LayoutMode: Left;
    Anchor: (Height: 56);
    Padding: (Full: 8);
    Background: #000000(0.35);
    OutlineColor: #2b3542;
    OutlineSize: 1;

    AssetImage #Icon {
      Anchor: (Width: 40, Height: 40);
    }

    Group {
      LayoutMode: Top;
      FlexWeight: 1;
      Padding: (Left: 10);

      Label #Name {
        Style: (RenderBold: true);
      }

      Label #Details {
        Style: (TextColor: #96a9be);
      }
    }
  }
}
