$C = "../../Common.ui";

@SlotStyle = (
  SlotSize: 46,
  SlotIconSize: 40,
  SlotSpacing: 4,
  SlotBackground: #000000(0.35)
);

$C.@PageOverlay {}

$C.@DecoratedContainer {
  @CloseButton = true;
  Anchor: (Width: 900, Height: 560);

  #Title {
    Group {
      $C.@Title {
        @Text = "Lab Station";
      }
    }
  }

  #Content {
    Group {
      LayoutMode: Left;
      FlexWeight: 1;

      // Left: the station's syringe slot and the player's inventory
      Group {
        LayoutMode: Top;
        Anchor: (Width: 470);
        Padding: (Right: 16);

        Label {
          Text: "Sample";
          Style: (RenderBold: true);
          Padding: (Bottom: 6);
        }

        ItemGrid #SampleSlot {
          Anchor: (Width: 50, Height: 50);
          SlotsPerRow: 1;
          AreItemsDraggable: true;
          RenderItemQualityBackground: true;
          Style: @SlotStyle;
        }

        Label {
          Text: "Inventory";
          Style: (RenderBold: true);
          Padding: (Top: 18, Bottom: 6);
        }

        ItemGrid #Storage {
          Anchor: (Width: 450, Height: 200);
          SlotsPerRow: 9;
          InventorySectionId: -2;
          AreItemsDraggable: true;
          RenderItemQualityBackground: true;
          Style: @SlotStyle;
        }

        ItemGrid #Hotbar {
          Anchor: (Width: 450, Height: 50, Top: 8);
          SlotsPerRow: 9;
          InventorySectionId: -1;
          AreItemsDraggable: true;
          RenderItemQualityBackground: true;
          Style: @SlotStyle;
        }
      }

      // Right: analysis of the sample
      Group {
        LayoutMode: Top;
        FlexWeight: 1;
        Padding: (Left: 16);
        Background: #000000(0.2);

        Label #EmptyLabel {
          Text: "Empty";
          Padding: (Full: 16);
          Style: (FontSize: 22, RenderBold: true, TextColor: #878e9c);
        }

        Group #Details {
          LayoutMode: Top;
          FlexWeight: 1;
          Visible: false;
          Padding: (Full: 12);

          Group {
            LayoutMode: Left;
            Anchor: (Height: 64);

            AssetImage #MobIcon {
              Anchor: (Width: 64, Height: 64);
            }

            Label #MobName {
              FlexWeight: 1;
              Padding: (Left: 12, Top: 16);
              Style: (FontSize: 24, RenderBold: true);
            }
          }

          Label {
            Text: "Stats (max)";
            Padding: (Top: 14, Bottom: 4);
            Style: (RenderBold: true, TextColor: #E8A93B);
          }

          Group #StatList {
            LayoutMode: Top;
          }

          Label {
            Text: "Status effects";
            Padding: (Top: 14, Bottom: 4);
            Style: (RenderBold: true, TextColor: #E8A93B);
          }

          Label #NoEffects {
            Text: "None";
            Style: (TextColor: #878e9c);
          }

          Group #EffectList {
            LayoutMode: TopScrolling;
            FlexWeight: 1;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
          }
        }
      }
    }
  }
}
